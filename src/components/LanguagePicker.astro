---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const currentPath = Astro.url.pathname;
const cleanPath = lang === 'id' ? currentPath : currentPath.replace(`/${lang}`, '') || '/';
---

<div class="flex items-center gap-2">
  {Object.entries(languages).map(([code, label]) => (
    <a
      href={code === 'id' ? cleanPath : `/${code}${cleanPath === '/' ? '' : cleanPath}`}
      class={`text-xs font-bold p-2.5 w-10 h-10 flex justify-center items-center rounded-full transition-colors border ${
        lang === code
          ? 'border-white text-white'
          : 'text-gray-500 border-gray-500 hover:border-white hover:text-white'
      }`}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>
