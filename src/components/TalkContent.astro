---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-black min-h-screen text-white pt-32 pb-24 font-sans selection:bg-white selection:text-black">
  <div class="container mx-auto px-6 md:px-12">
    
    <!-- Top Header Content -->
    <div class="text-center space-y-8 mb-24 md:mb-32">
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-medium tracking-tight">
        {t('talk.title')}
      </h1>
      
      <div class="space-y-4 text-sm md:text-base lg:text-lg text-gray-300 font-light max-w-3xl mx-auto">
        <p>{t('talk.subtitle1')}</p>
        <p class="leading-relaxed">
          {t('talk.subtitle2_1')}<br class="hidden md:block"/>
          {t('talk.subtitle2_2')}
        </p>
        <p>{t('talk.subtitle3')}</p>
      </div>
    </div>

    <!-- Form Section -->
    <div class="max-w-2xl flex flex-col md:flex-row gap-12 md:gap-24">
      <form class="w-full space-y-10">
        
        <div class="space-y-2 group">
          <label for="nama" class="block text-lg md:text-xl font-semibold text-white tracking-wide">{t('talk.label_name')}</label>
          <input 
            type="text" 
            id="nama" 
            placeholder={t('talk.placeholder')} 
            class="w-full bg-transparent border-0 border-b border-transparent group-hover:border-gray-800 focus:border-gray-400 focus:ring-0 px-0 py-2 text-gray-300 placeholder:text-gray-500 text-base outline-none transition-colors" 
          />
        </div>

        <div class="space-y-2 group">
          <label for="email" class="block text-lg md:text-xl font-semibold text-white tracking-wide">{t('talk.label_email')}</label>
          <input 
            type="email" 
            id="email" 
            placeholder={t('talk.placeholder')} 
            class="w-full bg-transparent border-0 border-b border-transparent group-hover:border-gray-800 focus:border-gray-400 focus:ring-0 px-0 py-2 text-gray-300 placeholder:text-gray-500 text-base outline-none transition-colors" 
          />
        </div>

        <div class="space-y-2 group">
          <label for="company" class="block text-lg md:text-xl font-semibold text-white tracking-wide">{t('talk.label_company')}</label>
          <input 
            type="text" 
            id="company" 
            placeholder={t('talk.placeholder')} 
            class="w-full bg-transparent border-0 border-b border-transparent group-hover:border-gray-800 focus:border-gray-400 focus:ring-0 px-0 py-2 text-gray-300 placeholder:text-gray-500 text-base outline-none transition-colors" 
          />
        </div>

        <div class="space-y-2 group">
          <label for="discuss" class="block text-lg md:text-xl font-semibold text-white tracking-wide">{t('talk.label_discuss')}</label>
          <input 
            type="text" 
            id="discuss" 
            placeholder={t('talk.placeholder')} 
            class="w-full bg-transparent border-0 border-b border-transparent group-hover:border-gray-800 focus:border-gray-400 focus:ring-0 px-0 py-2 text-gray-300 placeholder:text-gray-500 text-base outline-none transition-colors" 
          />
        </div>

        <div class="space-y-2 group">
          <label for="email2" class="block text-lg md:text-xl font-semibold text-white tracking-wide">{t('talk.label_email')}</label>
          <input 
            type="email" 
            id="email2" 
            placeholder={t('talk.placeholder')} 
            class="w-full bg-transparent border-0 border-b border-transparent group-hover:border-gray-800 focus:border-gray-400 focus:ring-0 px-0 py-2 text-gray-300 placeholder:text-gray-500 text-base outline-none transition-colors" 
          />
        </div>

        <div class="space-y-2 group">
          <label for="tellus" class="block text-lg md:text-xl font-semibold text-white tracking-wide">{t('talk.label_tellus')}</label>
          <textarea 
            id="tellus" 
            placeholder={t('talk.placeholder')} 
            rows="3"
            class="w-full bg-transparent border-0 border-b border-transparent group-hover:border-gray-800 focus:border-gray-400 focus:ring-0 px-0 py-2 text-gray-300 placeholder:text-gray-500 text-base outline-none transition-colors resize-none" 
          ></textarea>
        </div>

        <div class="pt-8">
          <button type="submit" class="inline-flex items-center gap-2 text-white font-semibold hover:text-gray-300 transition-colors">
            {t('talk.submit')}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </button>
        </div>
      </form>
    </div>
    
  </div>
</section>
