---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-black text-white py-20 md:py-32 font-sans">
  <div class="container mx-auto px-6 md:px-12">
    <div class="space-y-10 text-base md:text-lg font-light text-gray-300">
      
      <h2 class="text-3xl md:text-4xl font-medium text-white tracking-tight leading-snug">
        {t('footer_intermittent.title')}<br class="hidden md:block"/> {t('footer_intermittent.title_space')}
      </h2>
      
      <p class="leading-relaxed max-w-2xl">
        {t('footer_intermittent.desc1')}<br class="hidden md:block"/>
        {t('footer_intermittent.desc2')}<br class="hidden md:block"/>
        {t('footer_intermittent.desc3')}
      </p>

      <p>{t('footer_intermittent.time')}</p>

      <p class="leading-relaxed">
        {t('footer_intermittent.thanks')}<br/>
        {t('footer_intermittent.ready')}
      </p>

      <div class="pt-16 font-semibold text-white text-lg space-y-6">
        <p>{t('footer_intermittent.regards')}</p>
        <p>Novaren Tech</p>
      </div>

    </div>
  </div>
</footer>
