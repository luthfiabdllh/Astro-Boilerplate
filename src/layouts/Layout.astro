---
import SEO from '@/components/SEO.astro';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import '../styles/global.css';
import IntermittentNavbar from '@/components/layout/navbar/IntermittentNavbar.astro';

const { title, description, image, type, jsonld } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <SEO title={title} description={description} image={image} type={type} jsonld={jsonld} />
    <GoogleAnalytics />
  </head>
  <body class="bg-background  font-sans antialiased">

    <!-- Navbar -->
     <IntermittentNavbar/>

    <!-- Main Content -->
    <main>
      <div class="mx-auto">
        <slot />
      </div>
    </main>

    <!-- Footer -->

  </body>
</html>
