---
export const prerender = false;

import MainLayout from '@/layouts/MainLayout.astro';
import ArticleDetailContent from '@/components/ArticleDetailContent.astro';
import { getArticleBySlug } from '@/lib/api/articles';
import { getThumbnailUrl } from "@/lib/utils/media";
import { getLangFromUrl, getLocalizedPath } from '@/i18n/utils';

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);

let article = null;

if (!slug) {
  return Astro.redirect(getLocalizedPath('/404', lang));
}

try {
  article = await getArticleBySlug(slug);
} catch (err) {
  console.error("Fetch article error:", err);
}

if (!article) {
  return Astro.redirect(getLocalizedPath('/404', lang));
}

const thumbnailUrl = getThumbnailUrl(article.thumbnail);

const publishedDate = article.publishedAt
  ? new Date(article.publishedAt).toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "image": [
    thumbnailUrl ? new URL(thumbnailUrl, 'https://dfreeze.novarentech.com').href : "https://dfreeze.novarentech.com/og-image.jpg"
  ],
  "datePublished": article.publishedAt || article.createdAt,
  "dateModified": article.updatedAt || article.publishedAt || article.createdAt,
  "author": [{
      "@type": "Person",
      "name": "DFreeze Vet Team",
      "url": "https://dfreeze.novarentech.com"
  }]
};
---

<MainLayout
  title={article.title ?? 'Article'}
  description={article.title ?? 'Read pet health articles at DFreeze Vet Clinic.'}
  image={thumbnailUrl ?? undefined}
  type="article"
  jsonld={articleSchema}
>
  <ArticleDetailContent
    article={article}
    thumbnailUrl={thumbnailUrl ?? undefined}
    publishedDate={publishedDate ?? undefined}
  />
</MainLayout>
