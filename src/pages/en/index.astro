---
import MainLayout from '@/layouts/MainLayout.astro';
import HomeContent from '@/components/HomeContent.astro';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "VeterinaryCare",
  "name": "DFreeze Vet Clinic",
  "image": "https://dfreeze.novarentech.com/og-image.jpg",
  "@id": "https://dfreeze.novarentech.com",
  "url": "https://dfreeze.novarentech.com/en",
  "telephone": "+62211234567",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. Kesehatan No. 1",
    "addressLocality": "South Jakarta",
    "addressRegion": "DKI Jakarta",
    "postalCode": "12345",
    "addressCountry": "ID"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  }
};
---

<MainLayout
  title="Home"
  description="DFreeze Vet Clinic – Trusted veterinary clinic for your pet's healthcare. Consultation, vaccination, grooming, and surgery."
  jsonld={localBusinessSchema}
>
  <HomeContent />
</MainLayout>
